# Stripe (use test keys for development)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Server
PORT=5000
# FRONTEND_URL=http://localhost:5173
FRONTEND_URL=https://biomedpharmas.com
# Optional: extra CORS origins, comma-separated (e.g. for Vercel preview URLs)
# ADDITIONAL_ORIGINS=https://biomed-frontend.vercel.app,https://my-preview.vercel.app

# Admin (change in production)
ADMIN_EMAIL=admin@biomed.com
ADMIN_PASSWORD=admin123
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Order emails: admin gets order details at ADMIN_ORDER_EMAIL; customer gets confirmation at their email.
# Use Gmail App Password (2FA required): https://myaccount.google.com/apppasswords
ADMIN_ORDER_EMAIL=biomedinnovationpharmaceutical@gmail.com
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
